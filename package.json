{
  "name": "eslint-plugin-refined",
  "version": "0.0.3",
  "description": "ESLint plugin for refined React Native styles",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "bunx vitest run",
    "prepublishOnly": "bunx vitest run && bun run build",
    "release": "./scripts/release.sh"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "react-native",
    "styles",
    "lint"
  ],
  "devDependencies": {
